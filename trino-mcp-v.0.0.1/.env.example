# Trino / SEP connection (copy to .env and fill in secrets)
TRINO_HOST=sep.smprime.sm.ph
TRINO_PORT=443
TRINO_SCHEME=https
TRINO_USER=svc_ren3
TRINO_PASSWORD=
TRINO_AUTH=basic
TRINO_VERIFY=false

# Query limits
TRINO_MAX_ROWS=100

# Optional session defaults for unqualified table names
# TRINO_DEFAULT_CATALOG=
# TRINO_DEFAULT_SCHEMA=

# JSON object: catalog name → description for list_catalogs
CATALOG_DESCRIPTIONS={}

# Optional overlay (relative to trino-mcp/ or absolute). Sample playbook is always samples/sample_queries.yaml.
SEMANTIC_OVERLAY_PATH=semantic/overlay.smprime.yaml

# Introspection filters (comma-separated)
# INTROSPECT_CATALOGS=hive,postgresql
INTROSPECT_EXCLUDE_SCHEMAS=information_schema,pg_catalog,sys

# JWT auth (only if TRINO_AUTH=jwt)
# TRINO_JWT_TOKEN=
